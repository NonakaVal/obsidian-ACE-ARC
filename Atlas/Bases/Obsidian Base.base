views:
  - type: table
    name: Todas Notas
    filters:
      and:
        - '!file.inFolder("Calendar & Review")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.backlinks
      - collection
      - area
      - file.embeds
      - file.folder
    sort:
      - property: created
        direction: ASC
      - property: file.folder
        direction: DESC
    columnSize:
      file.backlinks: 253
      note.created: 178
      file.folder: 132
  - type: table
    name: Atlas
    filters:
      and:
        - file.inFolder("Atlas")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
  - type: table
    name: X (Assets)
    filters:
      and:
        - file.inFolder("X/Assets")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - summary
  - type: table
    name: X (Templates)
    filters:
      and:
        - file.inFolder("X/Templates")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - summary
  - type: table
    name: X
    filters:
      and:
        - file.inFolder("X")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - summary
